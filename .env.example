# SIGEB · Variables de entorno. Copia este archivo como .env y completa los valores.
# Nunca subas .env al repositorio.

# Base de datos propia de SIGEB
POSTGRES_PASSWORD=cambia-esta-contrasena
# Producción: sin-datos-prueba.sql (no carga cuentas con contraseña 1234). Pruebas: datos-prueba.sql.
DATOS_PRUEBA=datos-prueba.sql
# Solo para correr los servicios sin Docker (desarrollo y pruebas):
DATABASE_URL=postgres://sigeb:cambia-esta-contrasena@localhost:5432/sigeb

# Firma de los tokens JWT: al menos 32 caracteres aleatorios.
JWT_SECRET=reemplaza-con-una-cadena-aleatoria-de-al-menos-32-caracteres
# Minutos de bloqueo tras 5 intentos fallidos (la propuesta no fija el valor).
INTENTOS_MAXIMOS=3
MINUTOS_BLOQUEO=15
# Contraseña inicial de alumnos/profesores/colaboradores nuevos al sincronizar con la base escolar.
CONTRASENA_INICIAL_ESCOLAR=

# Integraciones (Propuesta 3.5). Sin estos valores cada integración opera en modo
# simulado y lo registra como "Simulado".
URL_BD_ESCOLAR=http://simulador-escolar:4101
URL_TESORERIA=http://simulador-tesoreria:4102
BANXICO_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SIGEB Biblioteca <biblioteca@ducky.edu.mx>
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
DIALOGFLOW_PROJECT_ID=
DIALOGFLOW_AGENT_ID=
DIALOGFLOW_LOCATION=us-central1
DIALOGFLOW_ACCESS_TOKEN=
# Agente del chatbot con Llama en Ollama (ADR 0003). Vacío = solo el clasificador local.
# En Docker Compose ya apunta al contenedor "ollama"; cámbialo solo si Ollama está en otro equipo.
#URL_OLLAMA=http://ollama:11434
MODELO_OLLAMA=llama3.2:3b
OLLAMA_TIEMPO_LIMITE_MS=45000

# Carpeta de respaldos (en un equipo distinto al servidor).
RUTA_RESPALDOS=./respaldos
